{
  "uid": "workshop-grpc-correction",
  "title": "Workshop · 04 · Replica distribution — corrected gRPC",
  "description": "Identical six panels and Prometheus queries to Stage 03, for fair comparison. Run the SAME JMeter workload and compare equivalent time windows. Corrected order-service uses headless product-service DNS and round_robin; improvement must be measured, not assumed. JMeter JTL captures client-side errors, including transport failures.",
  "tags": [
    "workshop",
    "k3s",
    "grpc"
  ],
  "schemaVersion": 41,
  "version": 3,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Healthy product pods (scrape targets)",
      "description": "Observed healthy scrape targets; verify Kubernetes Ready/Available replicas separately.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"spring-boot-staging\",application=\"product-service\",namespace=\"staging\"} == 1)",
          "legendFormat": "Ready"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Recorded product gRPC calls",
      "description": "Observed requests received by product-service over gRPC from order-service; selected Grafana time range.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(grpc_server_seconds_count{namespace=\"staging\",application=\"product-service\"}[$__range])) or vector(0)",
          "legendFormat": "gRPC calls"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Incoming gRPC calls by pod (calls/sec)",
      "description": "Completed gRPC calls/second by receiving product pod. In your baseline test, one pod receives almost all the gRPC calls.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod)(rate(grpc_server_seconds_count{namespace=\"staging\",application=\"product-service\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Direct HTTP requests by pod (req/sec)",
      "description": "Direct product HTTP traffic per pod (NOT the gRPC calls). Three close series here do not imply gRPC balancing.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod)(rate(http_server_requests_seconds_count{namespace=\"staging\",application=\"product-service\",uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "gRPC traffic share by pod (%) — selected time range",
      "description": "Percent of recorded completed product gRPC calls handled by each pod over the selected time range. 100% on one pod with three healthy pods indicates severe imbalance; a completely idle pod may appear with no time series, not an explicit zero. Requires actual order-service traffic.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (pod) (increase(grpc_server_seconds_count{namespace=\"staging\",application=\"product-service\"}[$__range])) / scalar(clamp_min(sum(increase(grpc_server_seconds_count{namespace=\"staging\",application=\"product-service\"}[$__range])), 0.001))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "gRPC call count by pod — selected time range",
      "description": "Count of completed product gRPC calls during the visible Grafana time range, grouped by actual pod. Compare active pods only, and note stale pod IDs after rollouts.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod)(increase(grpc_server_seconds_count{namespace=\"staging\",application=\"product-service\"}[$__range]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
