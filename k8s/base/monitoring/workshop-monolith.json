{
  "uid": "workshop-monolith",
  "title": "Workshop · 01 · Monolith — load & spike",
  "description": "Inspect throughput, slow tail latency and failures under load. JMeter virtual users and client-side outcomes remain in JTL/HTML reports. Server-side error panels now include 4xx, 5xx and nonstandard 6xx; use JMeter JTL for transport and assertion failures.",
  "tags": [
    "performance",
    "spring-boot",
    "monolith",
    "k3s",
    "azure",
    "workshop"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 4,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Open the Microservices dashboard",
      "type": "link",
      "url": "/d/microservices",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "query": "ERROR,WARN,INFO,DEBUG,UNKNOWN",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "search",
        "label": "Log search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP throughput — all monolith endpoints (req/s)",
      "description": "Total application requests completed each second, excluding Actuator.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\"}[1m]))",
          "legendFormat": "monolith"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP requests by method & endpoint (req/s)",
      "description": "Shows GET, POST and their endpoint paths independently; series appear when requests occur.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method,uri) (rate(http_server_requests_seconds_count{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\"}[1m]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests handled during selected range — by type",
      "description": "Estimated number of requests in the visible Grafana time window; select the JMeter run time.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method,uri) (increase(http_server_requests_seconds_count{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\"}[$__range]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP p95 response time (ms)",
      "description": "95th-percentile estimated server-side HTTP latency.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\"}[1m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP p99 response time (ms)",
      "description": "99th-percentile estimated server-side HTTP latency.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\"}[1m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP 4xx/5xx/6xx error rate (%)",
      "description": "Server-observed HTTP 4xx, 5xx and nonstandard 6xx responses. Client timeouts/refusals cannot appear here; analyze JMeter JTL for those.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum(rate(http_server_requests_seconds_count{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\",status=~\"[456]..\"}[1m]))) or (0 * sum(rate(http_server_requests_seconds_count{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\"}[1m])))) / clamp_min(sum(rate(http_server_requests_seconds_count{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\"}[1m])), 0.001)",
          "legendFormat": "monolith 5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU usage — monolith pod (cores)",
      "description": "CPU load of the running monolith pod.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"staging\",container=\"ecommerce-mono\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP 4xx / 5xx / 6xx by status (req/s)",
      "description": "Server responses grouped by exact status; 6xx is nonstandard, and network errors are client-only.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\",status=~\"[456]..\"}[1m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP 4xx+ error percentage — server observed",
      "description": "4xx/5xx/nonstandard 6xx responses divided by server-handled HTTP traffic; does NOT include JMeter client failures. Empty when no traffic.",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum(rate(http_server_requests_seconds_count{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\",status=~\"[456]..\"}[1m]))) or (0 * sum(rate(http_server_requests_seconds_count{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\"}[1m])))) / clamp_min(sum(rate(http_server_requests_seconds_count{namespace=\"staging\",uri!~\"/actuator.*\",architecture=\"monolith\"}[1m])),0.001)",
          "legendFormat": "HTTP 4xx+/total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
