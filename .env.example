# Copy to ".env" (repository root) and adapt. ".env" is git-ignored.

# ---------------- PostgreSQL / pgAdmin ----------------
POSTGRES_USER=test
POSTGRES_PASSWORD=test123456789
POSTGRES_DB=ecommercedb
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# ---------------- docker compose ----------------
# Stack started by a plain "docker compose up": microservices | monolith
COMPOSE_PROFILES=microservices

# ---------------- optional overrides ----------------
# Spring profile of the containers: dev (default) | staging | production
#SPRING_PROFILES_ACTIVE=dev
# JVM options of the containers
#JAVA_OPTS=-XX:MaxRAMPercentage=75.0
# Resource budget (same total for both architectures by default)
#MONO_CPUS=3
#MONO_MEMORY=3g
#SERVICE_CPUS=1
#SERVICE_MEMORY=1g
# Grafana login
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=admin
