<hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Pick user (per thread) and products (random)">
      <stringProp name="scriptLanguage">groovy</stringProp>
      <stringProp name="parameters"></stringProp>
      <stringProp name="filename"></stringProp>
      <stringProp name="cacheKey">true</stringProp>
      <stringProp name="script">// One dedicated user per thread: no concurrent writes on the same cart.
// Products are spread deterministically over (thread, iteration), so both architectures
// receive exactly the same sequence of requests.
// Note: no JDK class is referenced on purpose (no Math, Random...): the Groovy 3 engine bundled
// with JMeter 5.6.3 cannot resolve JDK classes when JMeter runs on Java 25.
def users = props.get('seed.userIds')
def products = props.get('seed.productIds')
int t = ctx.getThreadNum()
int it = vars.getIteration()
int n = products.size()
vars.put('userId', users[t % users.size()])
vars.put('productId', products[(t * 7919 + it * 104729) % n])
vars.put('productId2', products[(t * 15485863 + it * 32452843 + 1) % n])
</stringProp>
    </JSR223PreProcessor>
